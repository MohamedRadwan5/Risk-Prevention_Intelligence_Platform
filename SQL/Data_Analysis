       CONCAT(ROUND(d.untreated_30plus / d.patients_30plus * 100, 1), '%') AS untreated_pct_30plus,
       CONCAT(ROUND(h.obesity_rate_pct, 2), '%')                           AS obesity_pct,
       CONCAT(ROUND(h.sugar_starch_pct_of_calories, 2), '%')               AS sugar_starch_pct,
